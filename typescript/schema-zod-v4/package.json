{
  "name": "@a2ui/schema-zod-v4",
  "version": "0.1.0",
  "description": "Zod 4 schema adapter for A2UI catalogs",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b --pretty",
    "generate": "node scripts/generate.mjs && prettier --write \"src/schema/**/*.ts\" \"src/types/common-types.ts\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "tsc -b --pretty && node --test \"dist/**/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@a2ui/web_core_v1_0": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@a2ui/schema-zod": "workspace:*",
    "@types/node": "25.9.3",
    "eslint": "10.4.1",
    "prettier": "3.8.4",
    "typescript": "5.9.3"
  },
  "private": true
}
