{
  "name": "@a2ui/schema-zod",
  "version": "0.1.0",
  "description": "Zod schema adapter for A2UI catalogs",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./scripts/*": "./scripts/*"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "yarn generate && tsc -b --pretty",
    "generate": "node scripts/generate-zod-schemas.mjs && node scripts/generate-superset-common-types.mjs && prettier --write \"src/schema/**/*.ts\" \"src/types/*.ts\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "tsc -b --pretty && node --test \"dist/**/*.test.js\" \"tests/timing/*.test.mjs\"",
    "test:timing": "tsc -b --pretty && node --expose-gc --test --test-concurrency=1 \"tests/timing/**/*_test.mjs\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@a2ui/web_core_v1_0": "workspace:*",
    "json-schema-to-zod": "2.8.1",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^28.0.3",
    "@types/node": "25.9.3",
    "esbuild": "^0.28.1",
    "eslint": "10.4.1",
    "js-yaml": "^4.3.0",
    "jsdom": "^29.1.1",
    "lit": "^3.3.3",
    "prettier": "3.8.4",
    "typescript": "5.9.3"
  },
  "private": true
}
