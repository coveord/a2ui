{
  "name": "@a2ui/web_core_v1_0",
  "version": "0.1.0",
  "description": "A2UI web core for protocol v1.0",
  "homepage": "https://a2ui.org/",
  "repository": {
    "directory": "typescript/core/web_core_v1_0",
    "type": "git",
    "url": "git+https://github.com/a2ui-project/a2ui.git"
  },
  "bugs": {
    "url": "https://github.com/a2ui-project/a2ui/issues"
  },
  "keywords": [
    "a2ui",
    "web",
    "ai",
    "agent",
    "ui",
    "renderer"
  ],
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "wireit",
    "build:tsc": "wireit",
    "test": "wireit",
    "test:conformance": "wireit",
    "test:timing": "wireit",
    "generate-zod-schemas": "wireit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "wireit",
    "format:check": "wireit",
    "clean": "wireit"
  },
  "wireit": {
    "generate-zod-schemas": {
      "command": "node scripts/generate-standard-defs.mjs && node scripts/generate-zod-schemas.mjs && node scripts/generate-superset-common-types.mjs && prettier --write \"src/**/*.ts\"",
      "files": [
        "../../../specification/v1_0/json/*.json",
        "scripts/generate-standard-defs.mjs",
        "scripts/generate-zod-schemas.mjs",
        "scripts/generate-superset-common-types.mjs",
        "scripts/zod-generator-core.mjs",
        "src/types/helpers.ts",
        "src/types/child-ref-helpers.ts",
        "src/schema/helpers.ts"
      ],
      "output": [
        "src/standard_defs.ts",
        "src/types/common-types.ts",
        "src/schema/common-types.ts",
        "src/schema/agent-to-renderer.ts",
        "src/schema/renderer-to-agent.ts",
        "src/schema/renderer-capabilities.ts",
        "src/schema/catalog-definition.ts",
        "src/schema/index.ts"
      ]
    },
    "copy-spec": {
      "command": "node scripts/copy-spec.js",
      "files": [
        "../../../specification/v1_0/json/*.json",
        "scripts/copy-spec.js"
      ],
      "output": [
        "src/schemas/*.json"
      ]
    },
    "build": {
      "dependencies": [
        "build:tsc"
      ]
    },
    "build:tsc": {
      "command": "tsc -b --pretty",
      "dependencies": [
        "copy-spec",
        "generate-zod-schemas"
      ],
      "files": [
        "src/**/*.ts",
        "src/**/*.json",
        "tests/**/*.ts",
        "tsconfig.json"
      ],
      "output": [
        "dist/",
        "!dist/**/*.min.js{,.map}"
      ],
      "clean": "if-file-deleted"
    },
    "test": {
      "command": "node --test \"dist/**/*.test.js\" \"tests/timing/*.test.mjs\"",
      "dependencies": [
        "build",
        "test:conformance"
      ]
    },
    "test:conformance": {
      "command": "node tests/conformance/conformance_test.mjs",
      "dependencies": [
        "build"
      ],
      "files": [
        "tests/conformance/**",
        "../../../conformance/**"
      ],
      "output": []
    },
    "test:timing": {
      "command": "node --expose-gc --test --test-concurrency=1 \"tests/timing/**/*_test.mjs\"",
      "dependencies": [
        "build"
      ]
    },
    "clean": {
      "command": "rm -rf dist .tsbuildinfo .wireit"
    },
    "format": {
      "command": "prettier --write .",
      "files": [
        "src/**/*.ts",
        "src/**/*.json",
        "tests/**/*.ts",
        "scripts/**/*.js",
        "package.json",
        "tsconfig.json"
      ]
    },
    "format:check": {
      "command": "prettier --check .",
      "files": [
        "src/**/*.ts",
        "src/**/*.json",
        "tests/**/*.ts",
        "scripts/**/*.js",
        "package.json",
        "tsconfig.json"
      ]
    }
  },
  "author": "Google",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.3",
    "c8": "^11.0.0",
    "eslint": "^10.4.1",
    "js-yaml": "^4.3.0",
    "jsdom": "^29.1.1",
    "json-schema-to-zod": "^2.8.1",
    "typescript": "5.9.3",
    "wireit": "^0.15.0-pre.2",
    "yaml": "^2.8.1"
  },
  "dependencies": {
    "@lit/context": "^1.1.6",
    "@preact/signals-core": "^1.14.2",
    "lit": "^3.3.3",
    "redos-detector": "^6.1.4",
    "validate-color": "^2.2.4",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "private": true
}
