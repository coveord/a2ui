{
  "name": "@a2ui/web_core_v1_0",
  "version": "0.1.0",
  "description": "A2UI web core for protocol v1.0",
  "homepage": "https://a2ui.org/",
  "repository": {
    "directory": "typescript/core/web_core_v1_0",
    "type": "git",
    "url": "git+https://github.com/a2ui-project/a2ui.git"
  },
  "bugs": {
    "url": "https://github.com/a2ui-project/a2ui/issues"
  },
  "keywords": [
    "a2ui",
    "web",
    "ai",
    "agent",
    "ui",
    "renderer"
  ],
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./catalog": {
      "types": "./dist/src/catalog/index.d.ts",
      "default": "./dist/src/catalog/index.js"
    },
    "./state": {
      "types": "./dist/src/state/index.d.ts",
      "default": "./dist/src/state/index.js"
    },
    "./processing": {
      "types": "./dist/src/processing/index.d.ts",
      "default": "./dist/src/processing/index.js"
    },
    "./resolution": {
      "types": "./dist/src/resolution/index.d.ts",
      "default": "./dist/src/resolution/index.js"
    },
    "./rendering": {
      "types": "./dist/src/resolution/index.d.ts",
      "default": "./dist/src/resolution/index.js"
    },
    "./validation": {
      "types": "./dist/src/validation/index.d.ts",
      "default": "./dist/src/validation/index.js"
    },
    "./validating": {
      "types": "./dist/src/validation/integrity-checker.d.ts",
      "default": "./dist/src/validation/integrity-checker.js"
    },
    "./reactivity": {
      "types": "./dist/src/reactivity/index.d.ts",
      "default": "./dist/src/reactivity/index.js"
    },
    "./expressions": {
      "types": "./dist/src/expressions/index.d.ts",
      "default": "./dist/src/expressions/index.js"
    },
    "./adapters": {
      "types": "./dist/src/processing/adapters/index.d.ts",
      "default": "./dist/src/processing/adapters/index.js"
    },
    "./rpc": {
      "types": "./dist/src/rpc/index.d.ts",
      "default": "./dist/src/rpc/index.js"
    },
    "./errors": {
      "types": "./dist/src/errors.d.ts",
      "default": "./dist/src/errors.js"
    },
    "./events": {
      "types": "./dist/src/common/events.d.ts",
      "default": "./dist/src/common/events.js"
    },
    "./semver": {
      "types": "./dist/src/common/semver.d.ts",
      "default": "./dist/src/common/semver.js"
    },
    "./v1_0": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./universal": {
      "types": "./dist/src/universal/index.d.ts",
      "default": "./dist/src/universal/index.js"
    }
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "wireit",
    "build:tsc": "wireit",
    "test": "wireit",
    "test:conformance": "wireit",
    "test:timing": "wireit",
    "test:coverage": "c8 node --test \"dist/**/*.test.js\"",
    "generate-zod-schemas": "wireit",
    "compile": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "fix": "gts fix",
    "format": "wireit",
    "format:check": "wireit",
    "clean": "wireit"
  },
  "wireit": {
    "generate-zod-schemas": {
      "command": "node scripts/generate-standard-defs.mjs && prettier --write \"src/standard_defs.ts\"",
      "files": [
        "../../../specification/v1_0/json/*.json",
        "scripts/generate-standard-defs.mjs"
      ],
      "output": [
        "src/standard_defs.ts"
      ]
    },
    "copy-spec": {
      "command": "node scripts/copy-spec.js",
      "files": [
        "../../../specification/v1_0/json/*.json",
        "scripts/copy-spec.js"
      ],
      "output": [
        "src/schemas/*.json"
      ]
    },
    "build": {
      "dependencies": [
        "build:tsc"
      ]
    },
    "build:tsc": {
      "command": "tsc -b --pretty",
      "dependencies": [
        "copy-spec",
        "generate-zod-schemas"
      ],
      "files": [
        "src/**/*.ts",
        "src/**/*.json",
        "tests/**/*.ts",
        "tsconfig.json"
      ],
      "output": [
        "dist/",
        "!dist/**/*.min.js{,.map}"
      ],
      "clean": "if-file-deleted"
    },
    "test": {
      "command": "(cd ../../schema-zod && yarn build) && node --import ./dist/src/test/dom-setup.js --import ../../schema-zod/dist/src/index.js --test \"dist/**/*.test.js\" \"tests/timing/*.test.mjs\""
    },
    "test:timing": {
      "command": "node --expose-gc --test --test-concurrency=1 \"tests/timing/**/*_test.mjs\"",
      "dependencies": [
        "build"
      ]
    },
    "clean": {
      "command": "rm -rf dist .tsbuildinfo .wireit"
    },
    "format": {
      "command": "prettier --write .",
      "files": [
        "src/**/*.ts",
        "src/**/*.json",
        "tests/**/*.ts",
        "scripts/**/*.js",
        "package.json",
        "tsconfig.json"
      ]
    },
    "format:check": {
      "command": "prettier --check .",
      "files": [
        "src/**/*.ts",
        "src/**/*.json",
        "tests/**/*.ts",
        "scripts/**/*.js",
        "package.json",
        "tsconfig.json"
      ]
    }
  },
  "author": "Google",
  "license": "Apache-2.0",
  "devDependencies": {
    "@angular/core": "^21.2.5",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.3",
    "c8": "^11.0.0",
    "eslint": "^10.4.1",
    "google-artifactregistry-auth": "^3.5.0",
    "gts": "^7.0.0",
    "js-yaml": "^4.3.0",
    "jsdom": "^29.1.1",
    "rxjs": "^7.8.2",
    "typescript": "5.9.3",
    "wireit": "^0.15.0-pre.2",
    "yaml": "^2.8.1"
  },
  "dependencies": {
    "@lit/context": "^1.1.6",
    "@preact/signals-core": "^1.14.2",
    "lit": "^3.3.3",
    "redos-detector": "^6.1.4",
    "validate-color": "^2.2.4",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "private": true
}
